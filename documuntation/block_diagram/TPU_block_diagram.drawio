                <mxCell id="RRDM-oRTtDTz6cqkJhOE-235" value="&lt;span style=&quot;font-size: 36px;&quot;&gt;1 byte by 64 len&amp;nbsp; buffer&amp;nbsp;&lt;/span&gt;" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-830" y="-640" width="220" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="RRDM-oRTtDTz6cqkJhOE-236" value="&lt;span style=&quot;font-size: 36px;&quot;&gt;4 byte by 8 len&amp;nbsp; buffer&amp;nbsp;&lt;/span&gt;" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="270" y="-670" width="220" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="RRDM-oRTtDTz6cqkJhOE-237" value="&lt;span style=&quot;font-size: 36px;&quot;&gt;4 byte by 8 len&amp;nbsp; buffer&amp;nbsp;&lt;/span&gt;" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="670" y="-660" width="220" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="RRDM-oRTtDTz6cqkJhOE-238" value="&lt;span style=&quot;font-size: 36px;&quot;&gt;this is 4 byte by 64&amp;nbsp; lane buffer&amp;nbsp; which is&amp;nbsp; big compare to all other&amp;nbsp; that&#39;s why i&amp;nbsp; only use one of this type of buffer&amp;nbsp; for&amp;nbsp; storage&amp;nbsp; &amp;nbsp;&lt;/span&gt;" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
