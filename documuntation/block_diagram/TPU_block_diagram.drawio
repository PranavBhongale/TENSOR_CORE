                </mxCell>
                <mxCell id="RRDM-oRTtDTz6cqkJhOE-240" value="&lt;span style=&quot;font-size: 36px;&quot;&gt;the requirement of this buffer&amp;nbsp; is more more than 95%&lt;/span&gt;" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
