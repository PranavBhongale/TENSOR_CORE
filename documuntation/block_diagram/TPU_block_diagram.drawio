                            <mxPoint x="-640" y="130"/>
                            <mxPoint x="-620" y="920"/>
                            <mxPoint x="-6" y="920"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="aX0ZTY6pomOTaYQRHV6B-577" value="" style="whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="5050" y="-1990" width="940" height="1680" as="geometry"/>
                </mxCell>
                <mxCell id="aX0ZTY6pomOTaYQRHV6B-579" value="&lt;span style=&quot;font-size: 72px;&quot;&gt;&lt;b&gt;this is not just simple matrix multiplication unit this block contain GELU activation block which convert result of MAC into usable format of convolution&amp;nbsp;&lt;/b&gt;&lt;/span&gt;" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="5110" y="-1930" width="810" height="1520" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
