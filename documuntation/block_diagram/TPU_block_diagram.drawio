                <mxCell id="574" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;this block is the rom which contain lookup values of mac output it stores conversion of gelu value&amp;nbsp;&lt;/font&gt;&lt;/b&gt;" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
